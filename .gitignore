__pycache__/
*.pyc
.venv/
.pytest_cache/
# pip install -e . writes the egg-info into the checkout (pyproject.toml)
*.egg-info/
# a non-editable `pip install .` from the checkout can leave a build dir
build/
runs/
# compiled-trace cache when the repo root is the experiments workdir
# (framework/workdir.py; the compile entry points stay in trace/compile/)
cache/
# framework-generated outputs (not part of the open-source tree; the
# registry seeds and run evidence are local records)
results/
registry/
plugins/*/fidelity.json
