# plugins/agentgateway/versions.env — the binding's pinned identities
# (the same pin record the pre-guardscope probe carried, re-verified
# against the registries 2026-11-10; see README.md for the verification
# method and the full pin rationale).
#
# The control image: CNCF agentgateway, tag v1.5.0 (the version the
# pre-guardscope probe pinned and whose config semantics this binding was
# verified against, from the v1.5.0 source at rev fe67324). Pinned by the
# linux/arm64 MANIFEST digest (the strongest per-byte pin; `platform:
# linux/arm64` in the overlays matches the digest's architecture — no
# cross-arch emulation, the same discipline as the old probe). Current
# stable release is v1.7.0 (2026-10-27); v1.5.0 is retained deliberately:
# the binding reproduces the probe's configuration and the digest pair was
# re-verified live.
AGENTGATEWAY_VERSION=v1.5.0
AGENTGATEWAY_IMAGE=ghcr.io/agentgateway/agentgateway
AGENTGATEWAY_INDEX_DIGEST=sha256:bf2f339ef326d32def2aaeb44b1b4549801293c19b89e764a4228667d97d9896
AGENTGATEWAY_ARM64_DIGEST=sha256:f64c27c8bd8aa25f07864dab07072026e375f22c6298c2c2d64f7d6c08a24130
AGENTGATEWAY_AMD64_DIGEST=sha256:b9cdf753d7dbc7a574dd8bf55f8300a48663ba83357e61e8ffc9f1bb19ccd4b9
AGENTGATEWAY_SOURCE_REV=fe6732474a96a0363dfb9822859af4e9bab360fa

# The deployed config (the binding's enforcement_config artifact,
# plugins/agentgateway/config/t1-allow-all.json): the shim's policy_hash
# input (sha256 of the file as deployed). 2026-11-10 (phase 2a): the second
# require rule was added — the framework's reserved readiness tool
# (__readiness_check__, framework/contracts.py READINESS_TOOL) is DENIED so
# the runner's pre-window readiness request has a deny-able action while
# the measured surface stays allow-all (no workload trace calls it).
AGENTGATEWAY_CONFIG_DIGEST=sha256:7e4f3fdf5276b8a27625e465864d91d933ce8fcc04f0f92a14151d189a84ea8e

# The collector's base image (python:3.12-alpine, pinned by index digest;
# multi-arch: arm64 manifest sha256:218ad6ba54faeb7f1089f391c597a80c9d69ca88e561f71ebd77fb452d39249b).
AGENTGATEWAY_COLLECTOR_BASE=python:3.12-alpine@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7
