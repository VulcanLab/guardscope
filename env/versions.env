# Pinned versions for the inspection-coverage testbed.
# Filled from env/probe-server.sh results on the Linux server (M0 acceptance).
# Every run manifest references these values; update only with a new probe run.

# Host kernel (from uname -r on the server; 7.0.0-1013-aws booted 2026-10-06, probe + Tracee smoke re-validated)
KERNEL_VERSION=7.0.0-1013-aws
KERNEL_ARCH=aarch64

# Tracee sensor (smoke test validated v0.24.1; v0.20.0 fails on this kernel: sched_process_exec BPF load error -22)
TRACEE_IMAGE=aquasec/tracee
TRACEE_TAG=latest
TRACEE_VERSION=v0.24.1
TRACEE_DIGEST=sha256:cfbbfee972e64a644f6b1bac74ee26998e6e12442697be4c797ae563553a2a5b

# Mapping layer (C6) — sensor/mapping/rules.yaml `version`, pinned M3
# (v1 at M3; v4 live-validated in M4/M5; v5 adds /workspace/replay/ exclusion,
# M6; v6 adds gateway:8090 to http_tool_call tcp_ports, T1-5)
MAPPING_VERSION=6

# Container runtime
DOCKER_VERSION=29.8.2
COMPOSE_VERSION=5.6.0

# Tooling
BPFTOOL_VERSION=v7.7.0 (libbpf; unprivileged feature probe: 66 program/map types, JIT enabled)

# Harnesses (set in M4/M5 when adapters land)
OPENCLAW_VERSION=2026.9.3
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw
OPENCLAW_IMAGE_DIGEST=sha256:6cb72e1599b3b76e2ea3dcc2f4dd7f112247367fbecadfcdee8caa7423f4989b

# pi harness (M5; npm package per the containerization.md Docker pattern).
# 1.0.4 (T4): the harness-native enforcement design needs the 1.x extension
# API (scripted provider + tool_call permission hook); T0-T3 replay surfaces
# are unchanged.
PI_VERSION=1.0.4
PI_PACKAGE=@earendil-works/pi-coding-agent
PI_NODE_BASE_IMAGE=node:24-bookworm-slim
PI_NODE_BASE_IMAGE_DIGEST=sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553

# OpenCode spike (M5 exploration 2026-09-10; harness deferred — no no-LLM
# tool-execute route in 1.18.30, MCP path would need a mock-LLM provider)
OPENCODE_VERSION=1.18.30
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode
OPENCODE_IMAGE_DIGEST=sha256:412b37a894bb937a0d5d6a1860789b9fd7d34a109334bec98a3f6ecf812bb442

# Probe provenance
PROBE_DATE=2026-10-06
PROBE_HOST=AWS EC2 arm64 host (m7g.2xlarge, Ubuntu 24.04 LTS, aarch64; kernel 7.0.0-1013-aws)

# T1 gateway (microsoft/agent-governance-toolkit). The enforcement engine is
# the published agent_os.mcp_gateway module (MCP Security Gateway spec 1.0);
# the gateway/ container adds HTTP/JSON-RPC glue only. Policy pinned by
# GATEWAY_POLICY_VERSION (gateway/policy.yaml, allow-all for the trace tools).
GATEWAY_PACKAGE=agent-os-kernel
GATEWAY_PACKAGE_VERSION=3.7.0
GATEWAY_POLICY_VERSION=1
GATEWAY_AGENT_ID=t1-replay

# T2 forced egress (targets/egress-jail). One-shot alpine+nftables container
# per harness netns; applies a default-deny output policy allowing only the
# gateway (EGRESS_ALLOW_HOST:EGRESS_ALLOW_PORT) plus loopback. Policy pinned
# by EGRESS_POLICY_VERSION (apply.sh ruleset).
EGRESS_JAIL_BASE=alpine:3.22
EGRESS_POLICY_VERSION=2

# T3: fs tools proxied behind the gateway (gateway as sole enforcement
# point). targets/mcp-fs-http is the fs upstream; the gateway routes fs
# tools by name (UPSTREAM_FS_URL). Policy pinned by GATEWAY_T3_POLICY_VERSION
# (gateway/policy-t3.yaml, allow-all for all six trace tools).
GATEWAY_T3_POLICY_VERSION=1

# T7 kernel enforcement exemplar. OUT OF REACH on the current host: ActPlane
# 0.1.8's prebuilt eBPF fails the kernel-7.0 verifier (1M-insn complexity
# limit); master fails BPF_PROG_LOAD with E2BIG. Full incident record and the
# required container mounts in targets/actplane/README.md. Do not schedule a
# T7 run until a compatible host/kernel is provisioned.
ACTPLANE_VERSION=0.1.8
